# Splitwise OAuth app credentials from https://secure.splitwise.com/apps
SPLITWISE_CONSUMER_KEY=your_consumer_key_here
SPLITWISE_CONSUMER_SECRET=your_consumer_secret_here

# Access token from the OAuth test flow on your app page
SPLITWISE_API_KEY=your_access_token_here

# Optional defaults used when CSV rows omit these fields
SPLITWISE_DEFAULT_GROUP_ID=0
SPLITWISE_DEFAULT_CURRENCY=INR
