{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Splitwise FastTrack GUI",
      "type": "debugpy",
      "request": "launch",
      "module": "splitwise_bulk.gui",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Splitwise Bulk CLI (dry run)",
      "type": "debugpy",
      "request": "launch",
      "module": "splitwise_bulk.cli",
      "args": ["import", "sample_bank_export.csv", "--group-id", "0", "--dry-run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
